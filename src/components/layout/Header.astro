---
import { NAV_ITEMS } from "@/constants/header";
import { ArrowRight } from "@lucide/astro"

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="fixed top-0 left-0 w-full z-50 border-b border-dark/20 backdrop-blur-md">
  <div class="flex items-center justify-between max-w-7xl mx-auto w-full px-4 h-16">
    <div class="flex items-center gap-2.5">
      <div class="size-6 bg-primary rounded-md outline-3 outline-dark -rotate-12 custom-shadow"/>
      <h2 class="font-heading font-bold text-xl">Presets/Kits</h2>
    </div>
    <nav class="flex items-center gap-4">
      {
        NAV_ITEMS.map(({ label, href }) => {
          const normalizedHref = href.replace(/\/+$/, "") || "/";
          const isActive =
            normalizedHref === "/"
              ? currentPath === "/"
              : currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);

          return (
            <a
              href={href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "group relative py-2 px-2 font-medium text-base text-dark/60 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-dark hover:text-dark/90 transition-colors duration-300 ease-out motion-reduce:transition-none",
                isActive && "text-dark/90 font-semibold",
              ]}
            >
              {label}
            </a>
          );
        })
      }
      <button class="inline-flex items-center gap-1 px-6 py-2 rounded-full bg-primary outline-2 outline-dark 
        custom-shadow font-extrabold hover:-translate-y-1 transition-all duration-300 cursor-pointer">
        Probar Ahora <ArrowRight class="size-4" />
      </button>
    </nav>
  </div>
</header>