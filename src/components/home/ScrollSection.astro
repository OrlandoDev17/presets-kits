---
import { ArrowDown } from "@lucide/astro";

import HighlightedText from "@/components/ui/HighlightedText.astro";

interface Message {
	before?: string;
	highlight: string;
	after?: string;
	code?: string;
}

const MESSAGES: Message[] = [
	{ before: "LA RUEDA ES EL ", highlight: "TIMELINE." },
	{ before: "SCRUB = ", highlight: "SCROLL + TIEMPO." },
	{ before: "CADA PRESET ", highlight: "ENCAJA", after: " EN EL PLAN." },
	{ highlight: "CERO", after: " LISTENERS MANUALES." },
	{
		before: "TODO ESTO, ",
		highlight: "UNA LÍNEA.",
		code: "scrollTimeline({ scrub: true })",
	},
];

const SR_SENTENCES = MESSAGES.map(
	(message) =>
		`${message.before ?? ""}${message.highlight}${message.after ?? ""}`,
).join(" ");
---

<section data-scroll-section class="relative h-[400vh] lg:h-[500vh] bg-dark" aria-label="Demo de scroll con gsap-presets-kit">
  <div class="sticky top-0 h-svh overflow-hidden">
    <!-- Capas de fondo (parallax) -->
    <p
      data-scroll-ghost
      class="ghost-text pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-heading text-[30vw] leading-none font-black whitespace-nowrap  opacity-10 select-none"
      aria-hidden="true"
    >
      SCROLL
    </p>
    <div data-scroll-deco="a" class="absolute top-[18%] left-[8%] size-16 md:size-20 border-2 border-light/20" aria-hidden="true"></div>
    <div data-scroll-deco="b" class="absolute bottom-[22%] left-[14%] size-10 border-2 border-light/15" aria-hidden="true"></div>
    <div data-scroll-deco="c" class="absolute top-[30%] right-[6%] size-14 border-2 border-light/20" aria-hidden="true"></div>

    <!-- HUD -->
    <p class="pointer-events-none absolute top-4 left-4 lg:top-8 lg:left-8 z-20 font-mono text-xs text-light/40" aria-hidden="true">
      gsap-presets-kit / scrollTimeline + parallax
    </p>
    <p data-scroll-counter class="absolute right-4 bottom-4 lg:right-8 lg:bottom-8 z-20 font-mono text-sm text-light/50" aria-hidden="true">
      000%
    </p>

    <!-- Intro: estado inicial -->
    <div
      data-scroll-intro
      class="pointer-events-none absolute inset-0 z-10 flex flex-col items-center justify-center gap-4 px-4 text-center"
    >
      <span data-scroll-arrow class="text-primary" aria-hidden="true">
        <ArrowDown class="size-10 md:size-12"/>
      </span>
      <p class="font-heading text-5xl sm:text-7xl md:text-8xl font-black tracking-tight text-light">HAZ SCROLL</p>
      <p class="font-mono text-xs sm:text-sm md:text-base text-primary">TODO ESTO SE CONTROLA CON LA RUEDA</p>
    </div>

    <!-- Contenido scrubbed -->
    <div
      data-scroll-content
      class="absolute inset-0 z-10 grid items-center gap-6 px-4 sm:px-8 lg:grid-cols-2 lg:px-16 opacity-0"
    >
      <div class="relative order-2 lg:order-1 h-44 sm:h-52 lg:h-64 w-full max-w-2xl">
        {MESSAGES.map((message) => (
          <div data-scroll-msg class="absolute inset-0 flex flex-col justify-center gap-4 opacity-0">
            <h2 class="font-heading text-3xl sm:text-5xl xl:text-6xl font-black tracking-tight text-light">
              {message.before}
              <HighlightedText>{message.highlight}</HighlightedText>
              {message.after}
            </h2>
            {message.code && (
              <code class="w-fit border-2 border-light/20 px-4 py-2 font-mono text-sm md:text-base text-primary">
                {message.code}
              </code>
            )}
          </div>
        ))}
        <p class="sr-only">{SR_SENTENCES}</p>
      </div>
      <div class="order-1 lg:order-2 flex items-center justify-center">
        <div data-scroll-square class="size-28 sm:size-40 lg:size-56 xl:size-64 bg-primary border-2 border-light"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .ghost-text {
    -webkit-text-stroke: 2px var(--color-light);
  }
</style>

<script>
  import { animateFromTo, animateTo, parallax, presetContext, scrollTimeline } from "gsap-presets-kit";
  import { $, $$ } from "@/lib/dom";

  const section = $("[data-scroll-section]");
  const intro = $("[data-scroll-intro]");
  const arrow = $("[data-scroll-arrow]");
  const content = $("[data-scroll-content]");
  const counter = $("[data-scroll-counter]");
  const square = $("[data-scroll-square]");
  const ghost = $("[data-scroll-ghost]");
  const decos = $$("[data-scroll-deco]");
  const messages = $$("[data-scroll-msg]");

  // Mismos 10 vértices (mismo orden angular) para que GSAP interpole el clip-path.
  const RADIUS_CIRCLE = "50% 50% 50% 50% / 50% 50% 50% 50%";
  const RADIUS_FLAT = "0% 0% 0% 0% / 0% 0% 0% 0%";
  const RADIUS_BLOB = "62% 38% 55% 45% / 48% 62% 38% 52%";
  const CLIP_SQUARE =
    "polygon(50% 0%, 86.3% 0%, 100% 33.7%, 100% 66.3%, 66.3% 100%, 50% 100%, 33.7% 100%, 0% 66.3%, 0% 33.7%, 13.7% 0%)";
  const CLIP_STAR =
    "polygon(50% 0%, 61.76% 33.82%, 97.55% 34.55%, 69.02% 56.18%, 79.39% 90.45%, 50% 70%, 20.61% 90.45%, 30.98% 56.18%, 2.45% 34.55%, 38.24% 33.82%)";

  if (section && intro && content && counter && square && ghost) {
    // scrollTimeline no respeta prefers-reduced-motion por sí solo: estado final estático.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      intro.setAttribute("hidden", "");
      content.classList.remove("opacity-0");
      for (const [index, message] of messages.entries()) {
        message.classList.remove("opacity-0");
        if (index < messages.length - 1) message.setAttribute("hidden", "");
      }
      square.style.clipPath = CLIP_STAR;
      counter.textContent = "100%";
    } else {
      const ctx = presetContext();

      ctx.run(() => {
        const tl = scrollTimeline({
          trigger: section,
          start: "top top",
          end: "bottom bottom",
          scrub: 0.6,
          once: false,
          onUpdate: (self: { progress: number }) => {
            counter.textContent = `${String(Math.round(self.progress * 100)).padStart(3, "0")}%`;
          },
        });

        if (tl) {
          const START = 0.5;
          const SLOT = 1.9;
          const TOTAL = 10;

          // La intro se retira al empezar a scrollear.
          animateTo(intro, { y: -64, opacity: 0, duration: 0.45, ease: "power2.in", timeline: tl, position: 0.02 });
          animateTo(content, { opacity: 1, duration: 0.35, timeline: tl, position: 0.12 });
          if (arrow) {
            animateTo(arrow, { y: 10, repeat: -1, yoyo: true, duration: 0.6, ease: "power1.inOut" });
          }

          // Mensajes: cada uno entra y empuja fuera al anterior.
          for (const [index, message] of messages.entries()) {
            const at = START + index * SLOT;

            animateFromTo(
              message,
              { yPercent: 110, opacity: 0 },
              { yPercent: 0, opacity: 1, duration: 0.55, ease: "power3.out" },
              { timeline: tl, position: at },
            );

            if (index < messages.length - 1) {
              animateTo(message, { yPercent: -110, opacity: 0, duration: 0.45, ease: "power2.in", timeline: tl, position: at + SLOT });
            }
          }

          // El cuadrado muta con cada mensaje (opacity: 1 pisa el default 0 de animateTo).
          animateTo(square, {
            opacity: 1,
            borderRadius: RADIUS_CIRCLE,
            duration: 0.8,
            ease: "power2.inOut",
            timeline: tl,
            position: START,
          });
          animateTo(square, {
            opacity: 1,
            borderRadius: RADIUS_FLAT,
            rotation: 45,
            duration: 0.8,
            ease: "power2.inOut",
            timeline: tl,
            position: START + SLOT,
          });
          animateTo(square, {
            opacity: 1,
            borderRadius: RADIUS_BLOB,
            duration: 0.8,
            ease: "power2.inOut",
            timeline: tl,
            position: START + SLOT * 2,
          });
          animateFromTo(
            square,
            { clipPath: CLIP_SQUARE },
            {
              clipPath: CLIP_STAR,
              rotation: 0,
              borderRadius: RADIUS_FLAT,
              duration: 0.9,
              ease: "power2.inOut",
              immediateRender: false,
            },
            { timeline: tl, position: START + SLOT * 3 },
          );

          // Sostiene el mensaje final hasta el 100% del scroll.
          tl.to({}, { duration: TOTAL - (START + (messages.length - 1) * SLOT) - 0.55 });
        }

        // Capas de fondo: cada una deriva a su propio ritmo (profundidad).
        const scrollRange = { trigger: section, start: "top top", end: "bottom bottom" };

        parallax(ghost, { amount: 15, opacity: 0.04, scroll: scrollRange });
        if (decos[0]) parallax(decos[0], { amount: 80, scroll: scrollRange });
        if (decos[1]) parallax(decos[1], { amount: 150, scroll: scrollRange });
        if (decos[2]) parallax(decos[2], { axis: "x", amount: 100, scroll: scrollRange });
      });
    }
  }
</script>
