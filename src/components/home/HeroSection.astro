---
import { ArrowRight } from "@lucide/astro";

import Button from "@/components/ui/Button.astro";
import HighlightedText from "@/components/ui/HighlightedText.astro";
import TerminalCode from "@/components/ui/TerminalCode.astro";
import PresetShowcase from "@/components/home/PresetShowcase.astro";
---

<section class="flex flex-col justify-center gap-4 max-w-7xl mx-auto w-full px-4 mt-12" aria-labelledby="hero-title">
  <header data-hero="badge" class="flex items-center gap-2 px-4 py-1 border-2 border-dark rounded-full w-fit">
    <div class="size-2 bg-primary outline-2 outline-dark rounded-full"/>
    <p class="text-sm text-dark/75 font-medium font-mono m-0">gsap-presets-kit & motion-presets-kit</p>
  </header>
  <div class="grid lg:grid-cols-2 gap-8 w-full">
    <div class="flex flex-col gap-8">
      <h1 id="hero-title" class="text-5xl sm:text-6xl md:text-8xl font-black font-heading tracking-tight">
        MUEVE <HighlightedText>TODO</HighlightedText> CON UN <HighlightedText variant="dark">PRESET.</HighlightedText>
      </h1>
      <p data-hero="description" class="text-lg text-dark/75">
        Helpers <b class="text-dark font-semibold">tipados y validados con Zod</b> para <b class="text-dark font-semibold">GSAP</b> y <b class="text-dark font-semibold">Motion</b>. Defaults sensatos que reemplazas en cada llamada, <b class="text-dark font-semibold">scroll integrado</b> y <b class="text-dark font-semibold">prefers-reduced-motion</b> respetado de fabrica.
      </p>
      <div data-hero="actions" class="flex items-center gap-4">
        <div data-hero="action">
          <Button href="/playground">Abrir el Playground <ArrowRight /></Button>
        </div>
        <div data-hero="action">
          <Button variant="light" href="/docs">Leer Docs</Button>
        </div>
      </div>
      <div data-hero="terminals" class="flex flex-col gap-4">
        <TerminalCode code="pnpm add gsap-presets-kit gsap zod" variant="dark" />
        <TerminalCode code="pnpm add motion-presets-kit motion zod" variant="dark" />
      </div>
    </div>
    <PresetShowcase />
  </div>
</section>

<script>
  import gsap from "gsap";
  import { animateFrom, clipReveal, presetContext, splitTextReveal } from "gsap-presets-kit";
  import { $, $$ } from "@/lib/dom";

  const badge = $("[data-hero='badge']");
  const title = $("#hero-title");
  const description = $("[data-hero='description']");
  const card = $("[data-hero='card']");
  const codeLine = $("[data-hero='code-line']");
  const clipDemo = $("[data-hero='clip-demo']");
  const splitDemo = $("[data-hero='split-demo']");

  const actions = $$("[data-hero='action']");
  const terminals = $$("[data-hero='terminals'] > div");
  const tiles = $$("[data-hero='tiles'] article");
  const dots = $$("[data-hero='stagger-dots'] span");

  if (badge && title && description && card && codeLine && clipDemo && splitDemo) {
    const ctx = presetContext();

    ctx.run(() => {
      const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

      // Columna izquierda
      animateFrom(badge, { y: -24, opacity: 0, duration: 0.6, timeline: tl });
      animateFrom(title, { y: 48, opacity: 0, duration: 0.8, timeline: tl, position: 0.35 });
      animateFrom(description, { y: 24, opacity: 0, duration: 0.7, timeline: tl, position: 0.75 });
      animateFrom(actions, { scale: 0.8, opacity: 0, stagger: 0.12, duration: 0.6, ease: "back.out(1.7)", timeline: tl, position: 1 });
      animateFrom(terminals, { x: -48, opacity: 0, stagger: 0.12, duration: 0.7, timeline: tl, position: 1.2 });

      // Card (columna derecha)
      animateFrom(card, { y: 64, opacity: 0, rotation: 2, duration: 0.9, ease: "back.out(1.4)", timeline: tl, position: 0.15 });
      animateFrom(codeLine, { x: -16, opacity: 0, duration: 0.5, timeline: tl, position: 1.6 });
      animateFrom(tiles, { scale: 0.6, opacity: 0, stagger: 0.12, duration: 0.6, ease: "back.out(1.7)", timeline: tl, position: 1.8 });

      // Demos internas (dogfood: cada tile demuestra su preset)
      animateFrom(dots, { scale: 0, stagger: 0.04, duration: 0.4, timeline: tl, position: 2.3 });
      clipReveal(clipDemo, { direction: "up", timeline: tl, position: 2.4 });
      splitTextReveal(splitDemo, { type: "chars", stagger: 0.05, duration: 0.5, timeline: tl, position: 2.5 });
    });
  }
</script>
